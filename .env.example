BOT_TOKEN=7123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPERADMIN_ID=123456789
DATABASE_PATH=./data/bot.db
LOG_LEVEL=info

# AI spam analysis (optional, FEAT-019–025). Leave AI_PROVIDER empty to disable.
# Enables /tgwatch_analyze and the per-chat automatic scan (/tgwatch_set ai_scan ...).
#
# Recommended: Gemini Flash-Lite — has a free tier (rate-limited per day; check
# https://ai.google.dev/gemini-api/docs/rate-limits). Free-tier inputs may be used by Google
# for training, which is fine for public groups; use a paid key for private groups.
#   Key: https://aistudio.google.com/apikey
#
# Alternatives:
#   AI_PROVIDER=claude  → default model claude-haiku-5-5
#   AI_PROVIDER=openai  → AI_MODEL is required; for DeepSeek/OpenRouter etc. also set AI_BASE_URL
#
AI_PROVIDER=
AI_API_KEY=
# AI_MODEL=gemini-3.1-flash-lite   # default for gemini
# AI_BASE_URL=                     # endpoint override (OpenAI-compatible APIs, proxies)
