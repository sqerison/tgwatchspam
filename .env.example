BOT_TOKEN=7123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPERADMIN_ID=123456789
DATABASE_PATH=./data/bot.db
LOG_LEVEL=info

# AI-assisted spam analysis (optional, FEAT-016–020, not yet implemented)
# Enables /tgwatch_analyze — admin replies to a message to get AI-suggested keywords.
#
# Recommended: Gemini 2.0 Flash
#   - Free tier: 1,500 requests/day — covers typical admin usage at zero cost
#   - Get API key at: https://aistudio.google.com/apikey
#   - Paid rate if you exceed free tier: ~$0.10/1M tokens (negligible at this scale)
#
# Alternatives:
#   AI_PROVIDER=openai  → GPT-4o-mini (no free tier, ~$0.15/1M tokens)
#   AI_PROVIDER=claude  → Claude Haiku (no free tier, ~$0.80/1M tokens)
#   For DeepSeek/Perplexity: set AI_PROVIDER=openai and override AI_BASE_URL
#
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
# AI_MODEL=gemini-2.0-flash        # default, override if needed
# AI_BASE_URL=                     # OpenAI-compatible endpoint override (DeepSeek etc.)
